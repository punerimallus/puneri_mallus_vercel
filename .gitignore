# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/pluginsgit push -u origin codespaces --force
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source artwork for scripts/make-boxoffice-bg.mjs, not shipped.
# The script's OUTPUT (public/events/boxoffice-bg*.jpg) is committed and is what the site
# serves. This is the 1.1 MB original it was cut from: too heavy for the repo, and anything
# under public/ is publicly downloadable. Keep your copy locally to regenerate the backgrounds.
